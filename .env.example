# ScrapSense AI Environment Configuration
# Copy this file to .env and fill in your values

# ==================== MULTI-MODEL AI PROVIDERS ====================
# 1. OpenAI GPT (e.g. GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 2. Anthropic Claude (e.g. Claude 3.5 Sonnet, Claude 3 Haiku)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 3. Google Gemini / Project Astra (Multimodal AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 4. DataStax Astra DB (Cloud Vector/Document DB for Chat & Scrap Knowledge)
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_KEYSPACE=default_keyspace

# Default AI Provider (options: openai, claude, gemini)
DEFAULT_AI_PROVIDER=gemini

# ==================== CORE SYSTEM CONFIGURATION ====================
# JWT Secret Key (generate a random string)
JWT_SECRET_KEY=change-this-to-a-random-secret-key

# Admin credentials
ADMIN_LOGIN=admin@scrapsense.com
ADMIN_PASSWORD=change-this-strong-password

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=scrapsense

# AI Model (set to true to disable PyTorch/CLIP)
DISABLE_TORCH=false

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# SMTP Configuration (for OTP emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Development mode (set to false in production)
DEV_OTP_MODE=true
